APP_ENV=local
DJANGO_SETTINGS_MODULE=config.settings.base
DEBUG=1
SECRET_KEY=replace-me
ALLOWED_HOSTS=localhost,127.0.0.1
API_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://localhost:3000,http://127.0.0.1:3000
POSTGRES_DB=trainerhub
POSTGRES_USER=trainerhub
POSTGRES_PASSWORD=trainerhub
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
CACHE_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_DISPUTES_QUEUE=ops
CELERY_DISPUTES_CHARGEBACK_SYNC_EVERY_SECONDS=600
CELERY_DISPUTES_SLA_SWEEP_EVERY_SECONDS=1800
CELERY_EMAIL_QUEUE=email
CELERY_EMAIL_SWEEP_EVERY_SECONDS=60
CELERY_EMAIL_SWEEP_LIMIT=200
DISPUTE_SLA_ESCALATION_HOURS=72
DRF_ANON_THROTTLE_RATE=120/minute
DRF_USER_THROTTLE_RATE=1200/minute
AUTH_LOGIN_THROTTLE_RATE=10/minute
AUTH_REGISTER_THROTTLE_RATE=20/hour
AUTH_REFRESH_THROTTLE_RATE=60/minute
PAYMENTS_ALLOW_MOCK_PROVIDER=1
PAYMENTS_ALLOW_UNVERIFIED_PROVIDER_RETURN=1
PAYOUTS_REQUIRE_LEGAL_ELIGIBILITY=0
DEFAULT_FROM_EMAIL=TrainerHub <no-reply@localhost>
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
SENTRY_DSN=
VK_CLOUD_BUCKET=trainerhub-media
VK_CLOUD_REGION=ru-msk
VK_CLOUD_ENDPOINT=https://hb.bizmrg.com
VK_CLOUD_ACCESS_KEY=replace-me
VK_CLOUD_SECRET_KEY=replace-me
NEXT_PUBLIC_API_BASE=/api/v1
