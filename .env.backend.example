APP_ENV=local
DJANGO_SETTINGS_MODULE=config.settings.base
SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=*
DATABASE_URL=postgresql://trainerhub:trainerhub@postgres:5432/trainerhub
REDIS_URL=redis://redis:6379/0
CACHE_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_DISPUTES_QUEUE=ops
CELERY_DISPUTES_CHARGEBACK_SYNC_EVERY_SECONDS=600
CELERY_DISPUTES_SLA_SWEEP_EVERY_SECONDS=1800
CELERY_EMAIL_QUEUE=email
CELERY_EMAIL_SWEEP_EVERY_SECONDS=60
CELERY_EMAIL_SWEEP_LIMIT=200
DISPUTE_SLA_ESCALATION_HOURS=72
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000
AUTH_LOGIN_THROTTLE_RATE=10/minute
AUTH_REGISTER_THROTTLE_RATE=20/hour
AUTH_REFRESH_THROTTLE_RATE=60/minute
PAYMENTS_ALLOW_MOCK_PROVIDER=1
PAYMENTS_ALLOW_UNVERIFIED_PROVIDER_RETURN=1
PAYOUTS_REQUIRE_LEGAL_ELIGIBILITY=0
DEFAULT_FROM_EMAIL=TrainerHub <no-reply@localhost>
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
JWT_SIGNING_KEY=change-me-jwt
VK_S3_ENDPOINT_URL=https://s3.mcs.mail.ru
VK_S3_ACCESS_KEY_ID=change-me
VK_S3_SECRET_ACCESS_KEY=change-me
VK_PRIVATE_BUCKET=trainerhub-private
VK_PUBLIC_BUCKET=trainerhub-public
MEDIA_UPLOAD_TTL_SECONDS=900
MEDIA_READ_TTL_SECONDS=300
GLOBAL_COMMISSION_RATE=20.00
