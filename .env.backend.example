APP_ENV=local
DJANGO_SETTINGS_MODULE=config.settings.base
SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=*
# Production must replace wildcard hosts and use public https:// API/FRONTEND/CORS/CSRF origins.
API_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:8080
DATABASE_URL=postgresql://trainerhub:trainerhub@postgres:5432/trainerhub
REDIS_URL=redis://redis:6379/0
CACHE_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_WORKER_QUEUES=default,outbox,ops,email,media,notifications,billing
CELERY_DISPUTES_QUEUE=ops
CELERY_DISPUTES_CHARGEBACK_SYNC_EVERY_SECONDS=600
CELERY_DISPUTES_SLA_SWEEP_EVERY_SECONDS=1800
CELERY_EMAIL_QUEUE=email
CELERY_EMAIL_SWEEP_EVERY_SECONDS=60
CELERY_EMAIL_SWEEP_LIMIT=200
DISPUTE_SLA_ESCALATION_HOURS=72
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost,http://localhost:3000
AUTH_LOGIN_THROTTLE_RATE=10/minute
AUTH_REGISTER_THROTTLE_RATE=20/hour
AUTH_REFRESH_THROTTLE_RATE=60/minute
AUTH_LOGOUT_THROTTLE_RATE=60/minute
ANALYTICS_COLLECT_THROTTLE_RATE=300/minute
AFFILIATE_CLICK_THROTTLE_RATE=120/minute
REFERRAL_TRACK_THROTTLE_RATE=120/minute
ADMIN_OPS_THROTTLE_RATE=60/minute
MESSAGING_START_THROTTLE_RATE=30/minute
MESSAGING_SEND_THROTTLE_RATE=120/minute
REVIEW_WRITE_THROTTLE_RATE=30/hour
REVIEW_REPLY_THROTTLE_RATE=60/hour
ASSIGNMENT_SUBMIT_THROTTLE_RATE=120/hour
ASSIGNMENT_CREATE_THROTTLE_RATE=60/hour
ASSIGNMENT_REVIEW_THROTTLE_RATE=120/hour
PROGRESS_VIDEO_SAVE_THROTTLE_RATE=600/hour
PROGRESS_LESSON_COMPLETE_THROTTLE_RATE=120/hour
PAYMENTS_ALLOW_MOCK_PROVIDER=1
PAYMENTS_ALLOW_UNVERIFIED_PROVIDER_RETURN=1
PAYMENTS_WEBHOOK_REQUIRE_TIMESTAMP=0
PAYMENTS_WEBHOOK_REPLAY_TOLERANCE_SECONDS=300
PAYMENTS_WEBHOOK_MAX_BODY_BYTES=262144
PAYOUTS_REQUIRE_LEGAL_ELIGIBILITY=0
# Production must use PAYMENTS_ALLOW_MOCK_PROVIDER=0,
# PAYMENTS_ALLOW_UNVERIFIED_PROVIDER_RETURN=0,
# PAYMENTS_WEBHOOK_REQUIRE_TIMESTAMP=1 and PAYOUTS_REQUIRE_LEGAL_ELIGIBILITY=1.
DEFAULT_FROM_EMAIL=TrainerHub <no-reply@localhost>
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
JWT_SIGNING_KEY=change-me-jwt
# Production must set a real Sentry DSN for external error tracking.
SENTRY_DSN=
VK_S3_ENDPOINT_URL=https://s3.mcs.mail.ru
VK_S3_ACCESS_KEY_ID=change-me
VK_S3_SECRET_ACCESS_KEY=change-me
# Production must use separate buckets for private source media and public assets.
VK_PRIVATE_BUCKET=trainerhub-private
VK_PUBLIC_BUCKET=trainerhub-public
MEDIA_UPLOAD_TTL_SECONDS=900
MEDIA_READ_TTL_SECONDS=300
MEDIA_READ_MAX_TTL_SECONDS=900
MEDIA_MAX_UPLOAD_BYTES=5368709120
GLOBAL_COMMISSION_RATE=20.00
